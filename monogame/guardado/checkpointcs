using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;

namespace capybara;

/// <summary>
/// Objeto que actúa como punto de guardado al ser tocado por el jugador.
/// Guarda el nivel y la posición actual en el SaveManager.
/// </summary>
public class Checkpoint
{
    private Texture2D _textura;
    private Vector2 _posicion;
    private Rectangle _rect;
    private bool _activado = false;
    private int _nivel;

    // Animación
    private int _frameActual = 0;
    private int _totalFrames;
    private float _timerAnimacion = 0f;
    private float _tiempoPorFrame = 0.15f;
    private int _anchoFrame;

    public Checkpoint(Texture2D textura, Vector2 posicion, int nivel, int totalFrames = 1)
    {
        _textura = textura;
        _posicion = posicion;
        _nivel = nivel;
        _totalFrames = totalFrames;
        _anchoFrame = textura.Width / totalFrames;
        _rect = new Rectangle((int)posicion.X, (int)posicion.Y, _anchoFrame, textura.Height);
    }

    /// <summary>
    /// Comprueba si el jugador toca el checkpoint y guarda el progreso.
    /// </summary>
    public void Update(GameTime gameTime, MovedSprite jugador)
    {
        // Avanzar animación
        _timerAnimacion += (float)gameTime.ElapsedGameTime.TotalSeconds;
        if (_timerAnimacion >= _tiempoPorFrame)
        {
            _frameActual = (_frameActual + 1) % _totalFrames;
            _timerAnimacion = 0f;
        }

        // Detectar contacto con el jugador
        if (!_activado && _rect.Intersects(jugador.Rect))
        {
            _activado = true;
            SaveManager.Guardar(_nivel, jugador.position.X, jugador.position.Y);
        }
    }

    public void Draw(SpriteBatch spriteBatch)
    {
        Rectangle fuente = new Rectangle(_frameActual * _anchoFrame, 0, _anchoFrame, _textura.Height);
        // Cambia el tinte al activarse para dar feedback visual al jugador
        Color tinte = _activado ? Color.Gold : Color.White;
        spriteBatch.Draw(_textura, _posicion, fuente, tinte);
    }

    public bool Activado => _activado;
}